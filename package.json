{
  "name": "acatalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run data:build && npm run build:app",
    "build:app": "npm run data:stage && vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "data:bootstrap": "tsx scripts/sync-sources.ts",
    "data:sources": "tsx scripts/sync-sources.ts --latest",
    "data:stage": "tsx scripts/stage-public.ts",
    "data:inventory": "tsx scripts/inventory.ts",
    "data:build": "tsx scripts/build-catalog.ts",
    "data:github": "tsx scripts/enrich-github.ts",
    "data:icons": "tsx scripts/fetch-icons.ts",
    "data:deployments": "tsx scripts/discover-deployments.ts",
    "data:links": "tsx scripts/check-links.ts",
    "data:version": "tsx scripts/snapshot-catalog.ts",
    "check:budgets": "tsx scripts/check-budgets.ts",
    "data:all": "npm run data:inventory && npm run data:build && npm run data:github && npm run data:icons && npm run data:build && npm run data:version"
  },
  "dependencies": {
    "@lucide/vue": "^1.0.0",
    "@vueuse/core": "^14.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.16",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^24.9.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.38.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "playwright": "^1.56.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^4.0.3",
    "vue-tsc": "^3.1.1"
  }
}
